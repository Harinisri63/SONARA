APP_ENV=development
# SQL Server via ODBC Driver 18 (URL-encode special characters in the password)
DATABASE_URL=mssql+pyodbc://sa:CHANGE_ME@localhost:1433/sonara?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_32_CHARS_MIN
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
CORS_ORIGINS=http://localhost:4200,http://localhost:8100
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_BUCKET=sonara-media
